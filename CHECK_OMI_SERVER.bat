@echo off
setlocal
title OMI - Copy and Running Server Check
set "OMI_COPY_CHECK_HOME=%~dp0"
powershell -NoProfile -Command "& { $ErrorActionPreference='Continue'; $expected=@{'app.py'='3030d299a9992d7ac3e5404a18f3fe5a060bc3b83d2423586e988fa423f55826';'serve.py'='6ba2a353dcdf2c7a06264478b0441307d545e5c7d7e5c8e6a1bd8b469a0a2ce5';'diwany_routes.py'='1f3b81b96e243640019908445d99097029695c5b81578c5b8b5c442a3a7de029';'templates/_ui_macros.html'='2572e6951cd3a1b754e0ebacb775d2cfacd2767b995804958280fdcad4aee120';'templates/base.html'='a9e97ba27133a9dd40b2f6a25942fc5163f5d5e737480214f6afd0abbe0c7a01';'static/calendar.js'='97877f8bd20143e8eb30ac860807f7146d7c73a59d62a7d21d4b09cb5c8b3402';'templates/calendar.html'='1afe7505b8a5bc0d8b1b0ac0073796322132d166d87d447d1bb71ae48f9d82cd';'start.bat'='486e0ccc573017c68998fe641455ad8fcbef54cccc1030465b885484caea6930'}; $copyRoot=$env:OMI_COPY_CHECK_HOME; if (-not (Test-Path -LiteralPath (Join-Path $copyRoot 'app.py'))) { $nested=Join-Path $copyRoot 'OMI_Bitrix'; if (Test-Path -LiteralPath (Join-Path $nested 'app.py')) { $copyRoot=$nested } else { $copyRoot=(Read-Host 'Paste the full path of the extracted OMI_Bitrix folder').Trim().Trim([char]34) } }; $allMatch=$true; Write-Host ('Folder checked: '+$copyRoot); foreach ($name in $expected.Keys) { $file=Join-Path $copyRoot $name; if (-not (Test-Path -LiteralPath $file -PathType Leaf)) { $allMatch=$false; Write-Host ('MISSING: '+$name); continue }; $hashEngine=[System.Security.Cryptography.SHA256]::Create(); $fileStream=[System.IO.File]::OpenRead($file); try { $actual=[System.BitConverter]::ToString($hashEngine.ComputeHash($fileStream)).Replace('-','') } finally { $fileStream.Dispose(); $hashEngine.Dispose() }; if ($actual -eq $expected[$name]) { Write-Host ('MATCH source: '+$name) } else { $allMatch=$false; Write-Host ('DIFFERENT: '+$name) } }; foreach ($checkPort in @(5055,5056)) { Write-Host ('Port '+$checkPort); $listeners=@(Get-NetTCPConnection -State Listen -LocalPort $checkPort -ErrorAction SilentlyContinue); if (-not $listeners) { Write-Host 'No server is listening.'; continue }; foreach ($ownerId in @($listeners.OwningProcess | Sort-Object -Unique)) { $running=Get-CimInstance Win32_Process -Filter ('ProcessId='+$ownerId) -ErrorAction SilentlyContinue; Write-Host ('Process ID: '+$ownerId); Write-Host ('Executable: '+$running.ExecutablePath); $launch=$running.CommandLine; if ($launch -match '(?i)webhook|secret|token') { $launch='[Potentially sensitive arguments omitted]' }; Write-Host ('Launch: '+$launch); $parent=Get-CimInstance Win32_Process -Filter ('ProcessId='+$running.ParentProcessId) -ErrorAction SilentlyContinue; Write-Host ('Parent executable: '+$parent.ExecutablePath) }; $taskUrl='http://127.0.0.1:'+$checkPort+'/tasks?view=analysis&source=bitrix'; try { $response=Invoke-WebRequest -Uri $taskUrl -UseBasicParsing -TimeoutSec 5; $status=[int]$response.StatusCode } catch { $status=if ($_.Exception.Response) { [int]$_.Exception.Response.StatusCode } else { 0 } }; Write-Host ('Tasks page HTTP status: '+$status); if ($allMatch -and $status -eq 404) { Write-Host 'DIAGNOSIS: Extracted source files match, but this running server does not expose their Tasks route. The server on this port is not serving the checked copy.' }; if (-not $allMatch) { Write-Host 'DIAGNOSIS: This extracted folder does not match the current application source files.' }; if ($allMatch -and $status -eq 200) { Write-Host 'CHECK: Current source files match and the Tasks route is responding.' } }; Write-Host 'Read-only check. No process stopped, no settings or files changed.' }"
pause
